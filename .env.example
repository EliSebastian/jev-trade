# Alpaca paper trading keys (https://app.alpaca.markets/paper/dashboard/overview)
NUXT_ALPACA_KEY_ID=
NUXT_ALPACA_SECRET_KEY=

# Vercel AI Gateway key (https://vercel.com/ai-gateway). Jev is disabled without it.
NUXT_AI_GATEWAY_API_KEY=

# Jev engine rails. Uncomment to override the defaults shown.
# NUXT_JEV_NOTIONAL_USD=100
# NUXT_JEV_MAX_POSITIONS=5
# NUXT_JEV_COOLDOWN_MS=900000
# NUXT_JEV_STOP_LOSS_PCT=-0.02
# NUXT_JEV_TAKE_PROFIT_PCT=0.04
# NUXT_JEV_DAILY_LOSS_LIMIT_USD=200
# NUXT_JEV_INTERVAL_MS=300000
# NUXT_JEV_MIN_PROBABILITY=0.75
# NUXT_JEV_MIN_CONFIDENCE=0.6
# NUXT_JEV_MAX_AVOID=0.7
